    {
      "function_name": "caseManagement",
      "description": "{\n  \"name\": \"manage_case\",\n  \"description\": \"Create, update, retrieve, and save case details in the SafeNestt Case Management System.\",\n  \"parameters\": {\n    \"type\": \"object\",\n    \"properties\": {\n\n      \"action\": {\n        \"type\": \"string\",\n        \"enum\": [\"create\", \"update\", \"get\", \"list\"],\n        \"description\": \"What operation the agent should perform.\"\n      },\n\n      \"case_id\": {\n        \"type\": \"string\",\n        \"description\": \"ID of the case to update or retrieve.\"\n      },\n\n      \"client_info\": {\n        \"type\": \"object\",\n        \"description\": \"Client / Victim personal information.\",\n        \"properties\": {\n          \"name\": { \"type\": \"string\" },\n          \"email\": { \"type\": \"string\" },\n          \"phone\": { \"type\": \"string\" }\n        }\n      },\n\n      \"incident_details\": {\n        \"type\": \"object\",\n        \"description\": \"All incident information relevant to the case.\",\n        \"properties\": {\n          \"incident_type\": { \"type\": \"string\" },\n          \"description\": { \"type\": \"string\" },\n          \"loss_amount\": { \"type\": \"string\" },\n          \"location\": { \"type\": \"string\" },\n          \"dates\": { \"type\": \"string\" }\n        }\n      },\n\n      \"bank_or_wallet_info\": {\n        \"type\": \"object\",\n        \"description\": \"Optional: banking or crypto wallet details related to the scam.\",\n        \"properties\": {\n          \"bank_name\": { \"type\": \"string\" },\n          \"account_number\": { \"type\": \"string\" },\n          \"routing_number\": { \"type\": \"string\" },\n          \"wallet_address\": { \"type\": \"string\" },\n          \"network\": { \"type\": \"string\" }\n        }\n      },\n\n      \"admin_notes\": {\n        \"type\": \"string\",\n        \"description\": \"Internal notes by SafeNestt admin.\"\n      },\n\n      \"documents\": {\n        \"type\": \"array\",\n        \"description\": \"Any associated documents or files linked to the case.\",\n        \"items\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"document_type\": { \"type\": \"string\" },\n            \"document_url\": { \"type\": \"string\" }\n          }\n        }\n      }\n\n    },\n    \"required\": [\"action\"]\n  }\n}"
    },
    {
      "function_name": "mediaAI",
      "description": "{\n  \"name\": \"manage_media\",\n  \"description\": \"Upload, retrieve, and manage media (images, videos, audio, documents) for Mia Chat AI.\",\n  \"parameters\": {\n    \"type\": \"object\",\n    \"properties\": {\n\n      \"action\": {\n        \"type\": \"string\",\n        \"enum\": [\"upload\", \"retrieve\", \"list\", \"delete\"],\n        \"description\": \"What operation the agent should perform.\"\n      },\n\n      \"media_id\": {\n        \"type\": \"string\",\n        \"description\": \"ID of the media to retrieve or delete (not required for upload or list).\"\n      },\n\n      \"media_type\": {\n        \"type\": \"string\",\n        \"enum\": [\"image\", \"video\", \"audio\", \"document\"],\n        \"description\": \"Type of media being uploaded or retrieved.\"\n      },\n\n      \"file_name\": {\n        \"type\": \"string\",\n        \"description\": \"Optional: Name of the file for storing or retrieval purposes.\"\n      },\n\n      \"file_url\": {\n        \"type\": \"string\",\n        \"description\": \"URL or base64 encoded string of the media to upload.\"\n      },\n\n      \"description\": {\n        \"type\": \"string\",\n        \"description\": \"Optional: Description or caption for the media.\"\n      },\n\n      \"user_id\": {\n        \"type\": \"string\",\n        \"description\": \"ID of the user uploading or requesting the media.\"\n      }\n\n    },\n    \"required\": [\"action\"]\n  }\n}"
    },
    {
      "entity_name": "WebsiteCheck",
      "allowed_operations": [
        "create",
        "read",
        "update"
      ]
    }
  ],
  "whatsapp_greeting": "Hi! I'm Mia, your personal security assistant from SafeNest \ud83d\udee1\ufe0f\n\nI can help you:\n\u2022 Check your security score\n\u2022 Review active alerts\n\u2022 Analyze password strength\n\u2022 Guide you through threat resolution\n\u2022 Generate security reports\n\nWhat would you like to know about your digital safety today?",
  "name": "mia_security_advisor"
