{
  "name": "MediaPartnership",
  "type": "object",
  "properties": {
    "partner_name": {
      "type": "string"
    },
    "contact_person": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "prospect",
        "contacted",
        "negotiation",
        "signed",
        "rejected"
      ],
      "default": "prospect"
    },
    "details": {
      "type": "string",
      "description": "Notes or partnership details"
    },
    "project_id": {
      "type": "string",
      "description": "Linked Media Project ID"
    }
  },
  "required": [
    "partner_name",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}