{
  "name": "AuditEvent",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant id \u2014 server-side multi-tenant isolation. Set on create from the current user's tenant."
    },
    "actor": {
      "type": "string",
      "description": "Email of the actor"
    },
    "actor_name": {
      "type": "string",
      "description": "Display name of the actor"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "action": {
      "type": "string",
      "description": "The action performed (e.g. case_created, evidence_uploaded, investigation_started)"
    },
    "object_type": {
      "type": "string",
      "description": "Type of object affected (case, evidence, target, finding, report, etc.)"
    },
    "object_id": {
      "type": "string",
      "description": "ID of the affected object"
    },
    "case_id": {
      "type": "string",
      "description": "Related case ID if applicable"
    },
    "description": {
      "type": "string",
      "description": "Human-readable description of the event"
    },
    "metadata": {
      "type": "object",
      "description": "Additional event metadata"
    },
    "source": {
      "type": "string",
      "enum": [
        "user",
        "system",
        "hermes",
        "ai_run"
      ],
      "default": "user",
      "description": "Source of the event"
    }
  },
  "required": [
    "tenant_id",
    "action",
    "actor"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}