{
  "name": "InvestigationTarget",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant id \u2014 server-side multi-tenant isolation. Set on create from the current user's tenant."
    },
    "case_id": {
      "type": "string",
      "description": "ID of the related investigation case"
    },
    "type": {
      "type": "string",
      "enum": [
        "wallet_address",
        "transaction_hash",
        "token_contract",
        "blockchain_network",
        "domain",
        "url",
        "ip_address",
        "email",
        "phone",
        "username",
        "social_identifier",
        "other"
      ],
      "description": "Type of investigation target"
    },
    "value": {
      "type": "string",
      "description": "The target value (address, hash, URL, etc.)"
    },
    "network": {
      "type": "string",
      "description": "Blockchain network if applicable (ethereum, bitcoin, polygon, etc.)"
    },
    "label": {
      "type": "string",
      "description": "Investigator-assigned label"
    },
    "description": {
      "type": "string",
      "description": "Notes about this target"
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "case_import",
        "evidence_extraction",
        "hermes"
      ],
      "default": "manual",
      "description": "How the target was created"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "queued",
        "processing",
        "analyzed",
        "failed"
      ],
      "default": "pending",
      "description": "Hermes investigation status for this target"
    },
    "hermes_result": {
      "type": "object",
      "description": "Raw Hermes analysis result when available"
    },
    "last_investigated": {
      "type": "string",
      "format": "date-time"
    },
    "investigation_count": {
      "type": "number",
      "default": 0,
      "description": "Number of times submitted to Hermes"
    },
    "related_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Related evidence IDs"
    },
    "related_entities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Related entity IDs (Hermes)"
    }
  },
  "required": [
    "tenant_id",
    "case_id",
    "type",
    "value"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "tenant_role": "owner"
                  }
                },
                {
                  "user_condition": {
                    "tenant_role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "tenant_role": "investigator"
                  }
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}