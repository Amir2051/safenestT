{
  "name": "Tenant",
  "properties": {
    "description": {
      "type": "string"
    },
    "members": {
      "description": "User ids of members (denormalized for RLS read access)",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "name": {
      "description": "Tenant / organization display name",
      "type": "string"
    },
    "organization_type": {
      "description": "Type of organization. For new-org requests this is the requested type, approved by a platform admin after company verification.",
      "enum": [
        "bank_financial",
        "insurance",
        "pi_firm",
        "corporate_enterprise",
        "law_enforcement_gov",
        "security_investigation",
        "individual_investigator",
        "other"
      ],
      "type": "string"
    },
    "owner_email": {
      "description": "Email of the tenant owner",
      "type": "string"
    },
    "owner_user_id": {
      "description": "User id of the tenant owner",
      "type": "string"
    },
    "plan": {
      "default": "personal",
      "description": "Tenant plan tier. Personal workspaces are never listed as joinable.",
      "enum": [
        "personal",
        "team",
        "enterprise"
      ],
      "type": "string"
    },
    "rejected_at": {
      "format": "date-time",
      "type": "string"
    },
    "rejected_by": {
      "type": "string"
    },
    "rejection_reason": {
      "type": "string"
    },
    "requested_at": {
      "format": "date-time",
      "type": "string"
    },
    "requested_by_user_id": {
      "description": "User id of the account that requested this organization (new-org requests)",
      "type": "string"
    },
    "slug": {
      "description": "URL-safe unique slug",
      "type": "string"
    },
    "status": {
      "default": "active",
      "description": "Organization lifecycle status. 'pending_verification' = new org awaiting platform-admin company verification. Writes go through the orgAccess server function only.",
      "enum": [
        "pending_verification",
        "active",
        "verified",
        "suspended",
        "deleted"
      ],
      "type": "string"
    },
    "verification_notes": {
      "description": "Platform-admin notes from company verification",
      "type": "string"
    },
    "verified_at": {
      "format": "date-time",
      "type": "string"
    },
    "verified_by": {
      "description": "User id of the platform admin who verified the company/org",
      "type": "string"
    },
    "verified_by_email": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "owner_user_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.members": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}