{
  "name": "InvestigationReport",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant id \u2014 server-side multi-tenant isolation. Set on create from the current user's tenant."
    },
    "case_id": {
      "type": "string",
      "description": "ID of the related investigation case"
    },
    "title": {
      "type": "string",
      "description": "Report title"
    },
    "report_type": {
      "type": "string",
      "enum": [
        "investigation_report",
        "evidence_report",
        "blockchain_trace_report",
        "executive_summary",
        "finding_report",
        "dossier"
      ],
      "default": "investigation_report",
      "description": "Type of report"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "generated",
        "exported",
        "archived"
      ],
      "default": "draft",
      "description": "Report status"
    },
    "generated_by": {
      "type": "string",
      "enum": [
        "hermes",
        "investigator",
        "ai_run"
      ],
      "default": "ai_run",
      "description": "Who generated the report"
    },
    "generated_date": {
      "type": "string",
      "format": "date-time"
    },
    "content": {
      "type": "object",
      "description": "Structured report content"
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "classification": {
            "type": "string",
            "enum": [
              "fact",
              "evidence",
              "analysis",
              "inference",
              "hypothesis",
              "unknown"
            ]
          },
          "content": {
            "type": "string"
          }
        }
      },
      "description": "Report sections with classification labels (FACT, EVIDENCE, ANALYSIS, etc.)"
    },
    "evidence_register": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "evidence_id": {
            "type": "string"
          },
          "filename": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "hash": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          },
          "related_findings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "related_entities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "description": "Evidence register attached to this report"
    },
    "pdf_url": {
      "type": "string",
      "description": "Exported PDF URL"
    },
    "markdown_url": {
      "type": "string",
      "description": "Exported Markdown URL"
    },
    "json_url": {
      "type": "string",
      "description": "Exported JSON URL"
    },
    "conclusion": {
      "type": "string",
      "description": "Report conclusion"
    },
    "recommended_actions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Recommended next actions"
    },
    "created_by": {
      "type": "string",
      "description": "Email of report creator/requestor"
    },
    "generating_run_id": {
      "type": "string",
      "description": "InvestigationRun id that produced this report (auditable lineage)"
    }
  },
  "required": [
    "tenant_id",
    "case_id",
    "title",
    "report_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "tenant_role": "owner"
                  }
                },
                {
                  "user_condition": {
                    "tenant_role": "admin"
                  }
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}