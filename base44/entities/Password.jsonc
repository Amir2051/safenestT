{
  "name": "Password",
  "type": "object",
  "properties": {
    "site_name": {
      "type": "string",
      "description": "Website or service name"
    },
    "site_url": {
      "type": "string",
      "description": "Website URL"
    },
    "username": {
      "type": "string",
      "description": "Username or email"
    },
    "encrypted_password": {
      "type": "string",
      "description": "Encrypted password"
    },
    "password_strength": {
      "type": "string",
      "enum": [
        "weak",
        "medium",
        "strong",
        "excellent"
      ],
      "description": "Password strength rating"
    },
    "last_changed": {
      "type": "string",
      "format": "date-time",
      "description": "Last password change date"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    },
    "category": {
      "type": "string",
      "enum": [
        "social",
        "banking",
        "email",
        "shopping",
        "work",
        "other"
      ],
      "default": "other",
      "description": "Password category"
    },
    "compromised": {
      "type": "boolean",
      "default": false,
      "description": "Whether password was found in breach"
    }
  },
  "required": [
    "site_name",
    "username",
    "encrypted_password"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    },
    "write": {
      "created_by": "{{user.email}}"
    }
  }
}