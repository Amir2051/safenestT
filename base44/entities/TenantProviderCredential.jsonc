{
  "name": "TenantProviderCredential",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant (organization) that owns this credential. Set server-side from the caller's locked tenant_id."
    },
    "provider": {
      "type": "string",
      "enum": [
        "shodan",
        "virustotal"
      ],
      "enumColors": [
        "blue",
        "purple"
      ],
      "description": "OSINT provider this credential authenticates."
    },
    "api_key": {
      "type": "string",
      "description": "Provider API key. Server-only: written and read exclusively by the tenantProviderCredentials backend function using the service role. It is never returned to a browser."
    },
    "key_last4": {
      "type": "string",
      "description": "Last four characters of the key, used for masked display. Never the full key."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "invalid"
      ],
      "enumColors": [
        "green",
        "red"
      ],
      "default": "active",
      "description": "Whether the provider last accepted this key."
    },
    "verified_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last time the provider accepted this key."
    },
    "verified_by": {
      "type": "string",
      "description": "Email of the administrator who provisioned or last re-verified the key."
    },
    "last_error": {
      "type": "string",
      "description": "Provider's rejection reason when status is invalid."
    }
  },
  "required": [
    "tenant_id",
    "provider",
    "api_key"
  ],
  "rls": {
    "read": false,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}