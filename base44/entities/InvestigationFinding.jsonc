{
  "name": "InvestigationFinding",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant id \u2014 server-side multi-tenant isolation. Set on create from the current user's tenant."
    },
    "case_id": {
      "type": "string",
      "description": "ID of the related investigation case"
    },
    "title": {
      "type": "string",
      "description": "Finding title"
    },
    "description": {
      "type": "string",
      "description": "Detailed finding description"
    },
    "category": {
      "type": "string",
      "enum": [
        "fraud_indicator",
        "wallet_activity",
        "entity_connection",
        "transaction_pattern",
        "evidence_correlation",
        "risk_factor",
        "other"
      ],
      "default": "other",
      "description": "Finding category"
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium",
      "description": "Finding severity"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium",
      "description": "Confidence level"
    },
    "confidence_score": {
      "type": "number",
      "description": "Confidence score 0-100"
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "under_review",
        "verified",
        "rejected",
        "superseded"
      ],
      "default": "proposed",
      "description": "Review status \u2014 AI findings start as 'proposed' and are NOT auto-verified"
    },
    "source": {
      "type": "string",
      "enum": [
        "hermes",
        "investigator",
        "ai_run"
      ],
      "default": "ai_run",
      "description": "Who generated the finding"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Supporting evidence IDs"
    },
    "entity_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Related entity IDs"
    },
    "transaction_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Related transaction hashes"
    },
    "timeline_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Related timeline events"
    },
    "reviewer": {
      "type": "string",
      "description": "Email of reviewer"
    },
    "reviewer_name": {
      "type": "string",
      "description": "Name of reviewer"
    },
    "review_date": {
      "type": "string",
      "format": "date-time"
    },
    "review_notes": {
      "type": "string",
      "description": "Reviewer notes"
    },
    "review_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string"
          },
          "reviewer": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "description": "Full review history \u2014 every review action is auditable"
    },
    "hermes_raw": {
      "type": "object",
      "description": "Raw Hermes finding data"
    },
    "generating_run_id": {
      "type": "string",
      "description": "InvestigationRun id that produced this finding (auditable lineage)"
    }
  },
  "required": [
    "tenant_id",
    "case_id",
    "title",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}