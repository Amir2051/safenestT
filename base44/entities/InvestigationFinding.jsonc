{
  "name": "InvestigationFinding",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant id \u2014 server-side multi-tenant isolation. Set on create from the current user's tenant."
    },
    "case_id": {
      "type": "string",
      "description": "ID of the related investigation case"
    },
    "title": {
      "type": "string",
      "description": "Finding title"
    },
    "description": {
      "type": "string",
      "description": "Detailed finding description"
    },
    "category": {
      "type": "string",
      "enum": [
        "fraud_indicator",
        "wallet_activity",
        "entity_connection",
        "transaction_pattern",
        "evidence_correlation",
        "risk_factor",
        "other"
      ],
      "enumColors": [
        "blue",
        "purple",
        "pink",
        "yellow",
        "green",
        "red",
        "gray"
      ],
      "default": "other",
      "description": "Finding category"
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "enumColors": [
        "green",
        "yellow",
        "red",
        "red"
      ],
      "default": "medium",
      "description": "Finding severity"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "enumColors": [
        "red",
        "yellow",
        "green"
      ],
      "default": "medium",
      "description": "Confidence level"
    },
    "confidence_score": {
      "type": "number",
      "description": "Confidence score 0-100"
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "under_review",
        "verified",
        "partially_supported",
        "unsupported",
        "rejected",
        "superseded"
      ],
      "enumColors": [
        "gray",
        "blue",
        "green",
        "yellow",
        "red",
        "red",
        "gray"
      ],
      "default": "proposed",
      "description": "Review status. 'verified' requires at least one attached evidence item \u2014 the MIA engine downgrades a supported verdict with no evidence to 'partially_supported'. AI findings are never auto-verified without evidence."
    },
    "reality_check": {
      "type": "object",
      "description": "Audit trail of the MIA reality-check verdict for this finding: the provider verdict, the status it produced, the reasoning, and the InvestigationRun that produced it. Written by the MIA engine; never hand-edited.",
      "properties": {
        "status": {
          "type": "string",
          "description": "Final review status persisted from the reality check (verified | partially_supported | unsupported | not_verified)."
        },
        "verdict": {
          "type": "string",
          "description": "Raw verdict returned by the reality-check model (supported | partially_supported | unsupported)."
        },
        "reasoning": {
          "type": "string",
          "description": "The reality-check model's reasoning for this verdict."
        },
        "run_id": {
          "type": "string",
          "description": "InvestigationRun id of the reality-check phase that produced this verdict."
        },
        "checked_at": {
          "type": "string",
          "format": "date-time",
          "description": "When the verdict was recorded."
        },
        "provider": {
          "type": "string",
          "description": "Investigation provider that produced the verdict (mia)."
        },
        "evidence_gate": {
          "type": "string",
          "description": "Set when the engine's evidence gate changed the status, e.g. 'downgraded_to_partially_supported_no_evidence'."
        }
      }
    },
    "source": {
      "type": "string",
      "enum": [
        "hermes",
        "investigator",
        "ai_run"
      ],
      "enumColors": [
        "purple",
        "blue",
        "gray"
      ],
      "default": "ai_run",
      "description": "Who generated the finding"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Supporting evidence IDs"
    },
    "entity_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Related entity IDs"
    },
    "transaction_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Related transaction hashes"
    },
    "timeline_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Related timeline events"
    },
    "reviewer": {
      "type": "string",
      "description": "Email of reviewer"
    },
    "reviewer_name": {
      "type": "string",
      "description": "Name of reviewer"
    },
    "review_date": {
      "type": "string",
      "format": "date-time"
    },
    "review_notes": {
      "type": "string",
      "description": "Reviewer notes"
    },
    "review_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string"
          },
          "reviewer": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "description": "Full review history \u2014 every review action is auditable"
    },
    "hermes_raw": {
      "type": "object",
      "description": "Raw Hermes finding data"
    },
    "generating_run_id": {
      "type": "string",
      "description": "InvestigationRun id that produced this finding (auditable lineage)"
    }
  },
  "required": [
    "tenant_id",
    "case_id",
    "title",
    "status"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}