{
  "name": "WorkflowAutomation",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "description": "Human-readable description of this record, up to 1000 characters.",
      "maxLength": 1000
    },
    "automation_id": {
      "type": "string",
      "description": "Unique automation identifier"
    },
    "trigger_type": {
      "type": "string",
      "enum": [
        "auto_assign_cases",
        "case_status_law_enforcement",
        "priority_escalation",
        "recovery_amount_updated",
        "check_case_inactivity"
      ],
      "description": "What triggered the automation"
    },
    "action_type": {
      "type": "string",
      "enum": [
        "assign_task",
        "send_email",
        "send_notification",
        "update_status",
        "generate_report",
        "create_task"
      ],
      "description": "Action performed"
    },
    "trigger_entity_id": {
      "type": "string",
      "description": "ID of entity that triggered automation"
    },
    "trigger_entity_type": {
      "type": "string",
      "description": "Type of entity that triggered automation"
    },
    "result_entity_id": {
      "type": "string",
      "description": "ID of entity created by automation"
    },
    "result_entity_type": {
      "type": "string",
      "description": "Type of entity created"
    },
    "executed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When automation executed"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "failed",
        "pending"
      ],
      "default": "success",
      "description": "Automation execution status"
    },
    "error_message": {
      "type": "string",
      "description": "Error details if failed"
    },
    "execution_details": {
      "type": "object",
      "description": "Details about execution"
    }
  },
  "required": [
    "trigger_type",
    "action_type",
    "executed_at"
  ],
  "rls": {
    "create": true,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}