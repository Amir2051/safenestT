{
  "name": "AdminStatus",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "description": "Human-readable description of this record, up to 1000 characters.",
      "maxLength": 1000
    },
    "admin_id": {
      "type": "string"
    },
    "is_online": {
      "type": "boolean",
      "default": false
    },
    "last_active": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "admin_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "$or": [
        {
          "data.admin_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}