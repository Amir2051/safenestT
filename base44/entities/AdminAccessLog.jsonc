{
  "name": "AdminAccessLog",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "description": "Human-readable description of this record, up to 1000 characters.",
      "maxLength": 1000
    },
    "admin_email": {
      "type": "string",
      "description": "Email of the admin attempting access"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "failure"
      ],
      "description": "Outcome of the access attempt"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "ip_address": {
      "type": "string",
      "description": "IP address of the user"
    },
    "action": {
      "type": "string",
      "description": "What was accessed or attempted"
    }
  },
  "required": [
    "admin_email",
    "status",
    "timestamp"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": false,
    "delete": false
  }
}