{
  "name": "EvidenceItem",
  "properties": {
    "audit_history": {
      "description": "Access and modification audit trail",
      "items": {
        "properties": {
          "action": {
            "type": "string"
          },
          "actor": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "case_id": {
      "description": "ID of the related investigation case",
      "type": "string"
    },
    "description": {
      "description": "Investigator description of the evidence",
      "type": "string"
    },
    "detected_targets": {
      "description": "Targets auto-detected from evidence content (wallets, hashes, domains, etc.)",
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "evidence_type": {
      "default": "document",
      "description": "Category of evidence",
      "enum": [
        "document",
        "screenshot",
        "transaction",
        "communication",
        "video",
        "audio",
        "blockchain",
        "image",
        "archive",
        "other"
      ],
      "type": "string"
    },
    "file_hash": {
      "description": "Checksum/hash of the file",
      "type": "string"
    },
    "file_size": {
      "description": "Size in bytes",
      "type": "number"
    },
    "file_url": {
      "description": "Stored file URL",
      "type": "string"
    },
    "filename": {
      "description": "Original filename",
      "type": "string"
    },
    "mime_type": {
      "description": "MIME type of the file",
      "type": "string"
    },
    "original_filename": {
      "description": "Original filename if renamed",
      "type": "string"
    },
    "original_import": {
      "default": false,
      "description": "Whether this was from a case import",
      "type": "boolean"
    },
    "processing_notes": {
      "description": "Notes from Hermes processing",
      "type": "string"
    },
    "processing_status": {
      "default": "uploaded",
      "description": "Hermes processing status",
      "enum": [
        "uploaded",
        "queued",
        "processing",
        "processed",
        "failed",
        "review_required"
      ],
      "type": "string"
    },
    "related_entities": {
      "description": "IDs of related entities (Hermes)",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "related_findings": {
      "description": "IDs of related findings",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "related_targets": {
      "description": "IDs of related investigation targets",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "source": {
      "default": "manual_upload",
      "description": "How the evidence was added",
      "enum": [
        "manual_upload",
        "case_import",
        "hermes_extraction"
      ],
      "type": "string"
    },
    "tags": {
      "description": "Investigator tags",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "tenant_id": {
      "description": "Tenant id \u2014 server-side multi-tenant isolation. Set on create from the current user's tenant.",
      "type": "string"
    },
    "tool_result": {
      "description": "What an automated lookup actually returned (set once by the engine sync; not editable). state: data | empty | not_applicable | error | unknown. data_json holds the result payload (capped); data_sha256 is SHA-256 of the full canonical payload.",
      "properties": {
        "capability": {
          "type": "string"
        },
        "data_bytes": {
          "type": "number"
        },
        "data_json": {
          "type": "string"
        },
        "data_sha256": {
          "type": "string"
        },
        "record_count": {
          "type": "number"
        },
        "retrieved_at": {
          "type": "string"
        },
        "source_reference": {
          "type": "string"
        },
        "state": {
          "enum": [
            "data",
            "empty",
            "not_applicable",
            "error",
            "unknown"
          ],
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "target_kind": {
          "type": "string"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "rls": {
        "update": {
          "user_condition": {
            "collaborator_role": "editor"
          }
        }
      },
      "type": "object"
    },
    "uploaded_at": {
      "format": "date-time",
      "type": "string"
    },
    "uploaded_by": {
      "description": "Email of uploader",
      "type": "string"
    },
    "uploaded_by_name": {
      "description": "Name of uploader",
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "case_id",
    "filename",
    "file_url"
  ],
  "type": "object",
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}