{
  "name": "FamilyInvitation",
  "type": "object",
  "properties": {
    "invitation_id": {
      "type": "string",
      "description": "Unique invitation identifier"
    },
    "group_id": {
      "type": "string",
      "description": "Reference to FamilyGroup"
    },
    "invited_by_email": {
      "type": "string",
      "description": "Who sent the invitation"
    },
    "invited_by_name": {
      "type": "string",
      "description": "Name of inviter"
    },
    "invitee_email": {
      "type": "string",
      "description": "Email of person being invited"
    },
    "invitee_name": {
      "type": "string",
      "description": "Name of invitee"
    },
    "member_role": {
      "type": "string",
      "enum": [
        "parent",
        "child",
        "guardian",
        "teen"
      ],
      "default": "parent",
      "description": "Proposed role for invitee"
    },
    "age_category": {
      "type": "string",
      "enum": [
        "adult",
        "teen_13_17",
        "child_under_13"
      ],
      "default": "adult",
      "description": "Age category"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "declined",
        "expired",
        "cancelled"
      ],
      "default": "pending",
      "description": "Invitation status"
    },
    "created_date": {
      "type": "string",
      "format": "date-time",
      "description": "When invitation was sent"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Invitation expiration (7 days)"
    },
    "accepted_date": {
      "type": "string",
      "format": "date-time",
      "description": "When invitation was accepted"
    },
    "invitation_token": {
      "type": "string",
      "description": "Secure token for invitation link"
    },
    "permissions": {
      "type": "object",
      "description": "Proposed permissions for this member"
    },
    "message": {
      "type": "string",
      "description": "Personal message from inviter"
    }
  },
  "required": [
    "group_id",
    "invited_by_email",
    "invitee_email",
    "member_role"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "invitee_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    },
    "write": {
      "created_by": "{{user.email}}"
    }
  }
}