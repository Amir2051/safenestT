{
  "name": "Investment",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_escrow",
        "paid_to_company",
        "refunded",
        "flagged",
        "cancelled"
      ],
      "default": "pending_escrow"
    },
    "transaction_hash": {
      "type": "string",
      "description": "Blockchain tx hash if crypto"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "wallet",
        "bank",
        "card"
      ]
    },
    "escrow_release_date": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "company_id",
    "amount"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_id": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": false
  }
}