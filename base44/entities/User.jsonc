{
  "name": "User",
  "properties": {
    "account_status": {
      "default": "active",
      "description": "Account approval status",
      "enum": [
        "active",
        "pending",
        "rejected",
        "suspended"
      ],
      "rls": {
        "update": {
          "user_condition": {
            "collaborator_role": "editor"
          }
        }
      },
      "type": "string"
    },
    "approved_at": {
      "description": "When the user was approved",
      "format": "date-time",
      "rls": {
        "update": {
          "user_condition": {
            "collaborator_role": "editor"
          }
        }
      },
      "type": "string"
    },
    "approved_by": {
      "description": "Admin who approved the user",
      "rls": {
        "update": {
          "user_condition": {
            "collaborator_role": "editor"
          }
        }
      },
      "type": "string"
    },
    "country": {
      "description": "User's country",
      "type": "string"
    },
    "is_admin": {
      "description": "Legacy platform-admin flag. Locked: only set by Base44 editors or server code.",
      "rls": {
        "update": {
          "user_condition": {
            "collaborator_role": "editor"
          }
        }
      },
      "type": "boolean"
    },
    "job_title": {
      "description": "Job title. Locked because some functions grant access by title (Fraud Specialist); only admins set it via updateUserProfile.",
      "rls": {
        "update": {
          "user_condition": {
            "collaborator_role": "editor"
          }
        }
      },
      "type": "string"
    },
    "last_login": {
      "description": "Last login timestamp (if available).",
      "format": "date-time",
      "type": "string"
    },
    "last_scan_date": {
      "format": "date-time",
      "type": "string"
    },
    "monitored_emails": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "organization_contact_address": {
      "description": "Organization contact address.",
      "properties": {
        "city": {
          "type": "string"
        },
        "country": {
          "type": "string"
        },
        "line1": {
          "type": "string"
        },
        "line2": {
          "type": "string"
        },
        "postal_code": {
          "type": "string"
        },
        "state": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "organization_contact_phone": {
      "description": "Organization primary contact phone.",
      "type": "string"
    },
    "organization_name": {
      "description": "Name of the organization this user belongs to. Set during organization onboarding.",
      "type": "string"
    },
    "organization_role": {
      "description": "Organization role. Drives navigation AND data rules. LOCKED: set only by the orgAccess server function.",
      "enum": [
        "PLATFORM_ADMIN",
        "ORG_ADMIN",
        "INVESTIGATOR",
        "ANALYST",
        "CASE_MANAGER",
        "VIEWER",
        "AUDITOR"
      ],
      "rls": {
        "update": {
          "user_condition": {
            "collaborator_role": "editor"
          }
        }
      },
      "type": "string"
    },
    "organization_type": {
      "description": "Type of organization the user represents.",
      "enum": [
        "bank_financial",
        "insurance",
        "pi_firm",
        "corporate_enterprise",
        "law_enforcement_gov",
        "security_investigation",
        "individual_investigator",
        "other"
      ],
      "type": "string"
    },
    "phone": {
      "description": "Phone number",
      "type": "string"
    },
    "profile_image": {
      "description": "URL to profile image",
      "type": "string"
    },
    "risk_score": {
      "description": "Security risk score",
      "type": "number"
    },
    "subscription_plan": {
      "default": "free",
      "enum": [
        "free",
        "basic",
        "elite",
        "trial"
      ],
      "type": "string"
    },
    "subscription_status": {
      "default": "inactive",
      "enum": [
        "active",
        "inactive",
        "cancelled",
        "past_due"
      ],
      "type": "string"
    },
    "tenant_id": {
      "description": "Active tenant id for multi-tenant isolation. Referenced by RLS on investigation entities. LOCKED: set only by the orgAccess server function.",
      "rls": {
        "update": {
          "user_condition": {
            "collaborator_role": "editor"
          }
        }
      },
      "type": "string"
    },
    "tenant_role": {
      "description": "Legacy tenant-scoped role (owner/admin/investigator/member). LOCKED: set only by the orgAccess server function.",
      "enum": [
        "owner",
        "admin",
        "investigator",
        "member"
      ],
      "rls": {
        "update": {
          "user_condition": {
            "collaborator_role": "editor"
          }
        }
      },
      "type": "string"
    },
    "two_factor_enabled": {
      "type": "boolean"
    },
    "username": {
      "description": "Username",
      "type": "string"
    },
    "vpn_enabled": {
      "type": "boolean"
    },
    "wallet_address": {
      "description": "User's crypto wallet address",
      "type": "string"
    }
  },
  "required": [],
  "type": "object"
}