{
  "name": "User",
  "type": "object",
  "properties": {
    "account_status": {
      "type": "string",
      "enum": [
        "active",
        "pending",
        "rejected",
        "suspended"
      ],
      "default": "active",
      "description": "Account approval status"
    },
    "approved_by": {
      "type": "string",
      "description": "Admin who approved the user"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the user was approved"
    },
    "country": {
      "type": "string",
      "description": "User's country"
    },
    "profile_image": {
      "type": "string",
      "description": "URL to profile image"
    },
    "wallet_address": {
      "type": "string",
      "description": "User's crypto wallet address"
    },
    "username": {
      "type": "string",
      "description": "Username"
    },
    "phone": {
      "type": "string",
      "description": "Phone number"
    },
    "vpn_enabled": {
      "type": "boolean"
    },
    "two_factor_enabled": {
      "type": "boolean"
    },
    "risk_score": {
      "type": "number",
      "description": "Security risk score"
    },
    "last_scan_date": {
      "type": "string",
      "format": "date-time"
    },
    "subscription_plan": {
      "type": "string",
      "enum": [
        "free",
        "basic",
        "elite",
        "trial"
      ],
      "default": "free"
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "cancelled",
        "past_due"
      ],
      "default": "inactive"
    },
    "monitored_emails": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tenant_id": {
      "type": "string",
      "description": "Active tenant id for multi-tenant isolation. Referenced by RLS on investigation entities."
    },
    "tenant_role": {
      "type": "string",
      "enum": [
        "owner",
        "admin",
        "investigator",
        "member"
      ],
      "description": "Legacy tenant-scoped role (owner/admin/investigator/member)."
    },
    "organization_name": {
      "type": "string",
      "description": "Name of the organization this user belongs to. Set during organization onboarding."
    },
    "organization_type": {
      "type": "string",
      "enum": [
        "bank_financial",
        "insurance",
        "pi_firm",
        "corporate_enterprise",
        "law_enforcement_gov",
        "security_investigation",
        "individual_investigator",
        "other"
      ],
      "description": "Type of organization the user represents."
    },
    "organization_role": {
      "type": "string",
      "enum": [
        "PLATFORM_ADMIN",
        "ORG_ADMIN",
        "INVESTIGATOR",
        "ANALYST",
        "CASE_MANAGER",
        "VIEWER",
        "AUDITOR"
      ],
      "description": "Canonical UI role driving role-based navigation. PLATFORM_ADMIN is internal and never offered during public signup. Backend/Hermes enforces actual permissions separately."
    },
    "organization_contact_phone": {
      "type": "string",
      "description": "Organization primary contact phone."
    },
    "organization_contact_address": {
      "type": "object",
      "properties": {
        "line1": {
          "type": "string"
        },
        "line2": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "postal_code": {
          "type": "string"
        },
        "country": {
          "type": "string"
        }
      },
      "description": "Organization contact address."
    },
    "last_login": {
      "type": "string",
      "format": "date-time",
      "description": "Last login timestamp (if available)."
    }
  },
  "required": []
}