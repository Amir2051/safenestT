{
  "name": "InvestigationCase",
  "type": "object",
  "properties": {
    "case_number": {
      "type": "string",
      "description": "Internal case reference number"
    },
    "case_title": {
      "type": "string",
      "description": "Case title"
    },
    "victim_name": {
      "type": "string",
      "description": "Victim full name"
    },
    "victim_email": {
      "type": "string",
      "description": "Victim email"
    },
    "victim_phone": {
      "type": "string",
      "description": "Victim phone"
    },
    "victim_contact_info": {
      "type": "object",
      "properties": {
        "primary_email": {
          "type": "string"
        },
        "secondary_email": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "mobile": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "zip": {
          "type": "string"
        },
        "country": {
          "type": "string"
        },
        "preferred_contact_method": {
          "type": "string",
          "enum": [
            "email",
            "phone",
            "text",
            "mail"
          ]
        },
        "emergency_contact": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "phone": {
              "type": "string"
            },
            "relationship": {
              "type": "string"
            }
          }
        }
      },
      "description": "Comprehensive victim contact information"
    },
    "ic3_complaint_number": {
      "type": "string",
      "description": "FBI IC3 complaint number"
    },
    "federal_case_number": {
      "type": "string",
      "description": "Federal case number if assigned"
    },
    "fraud_type": {
      "type": "string",
      "enum": [
        "crypto_theft",
        "phishing",
        "fake_exchange",
        "rug_pull",
        "romance_scam",
        "investment_scam",
        "pig_butchering",
        "ransomware",
        "other"
      ],
      "description": "Type of fraud"
    },
    "scammer_info": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "website": {
          "type": "string"
        },
        "social_media": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "wallet_addresses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "Scammer details"
    },
    "suspect_details": {
      "type": "object",
      "properties": {
        "primary_suspect": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "aliases": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "email": {
              "type": "string"
            },
            "phone": {
              "type": "string"
            },
            "location": {
              "type": "string"
            }
          }
        },
        "known_associates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "relationship": {
                "type": "string"
              },
              "contact": {
                "type": "string"
              }
            }
          }
        },
        "websites_domains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ip_addresses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "wallet_addresses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "social_profiles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "platform": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            }
          }
        }
      },
      "description": "Detailed suspect investigation data"
    },
    "amount_stolen": {
      "type": "number",
      "description": "Amount stolen in crypto"
    },
    "amount_stolen_usd": {
      "type": "number",
      "description": "Amount stolen in USD"
    },
    "cryptocurrency": {
      "type": "string",
      "description": "Type of cryptocurrency stolen"
    },
    "blockchain": {
      "type": "string",
      "description": "Blockchain network"
    },
    "incident_date": {
      "type": "string",
      "format": "date-time",
      "description": "When fraud occurred"
    },
    "incident_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Exact timestamp of incident"
    },
    "description": {
      "type": "string",
      "description": "Detailed incident description"
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "event": {
            "type": "string"
          },
          "details": {
            "type": "string"
          }
        }
      },
      "description": "Case timeline"
    },
    "evidence_files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "uploaded_date": {
            "type": "string"
          }
        }
      },
      "description": "Evidence files"
    },
    "evidence_log": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "evidence_type": {
            "type": "string",
            "enum": [
              "document",
              "screenshot",
              "transaction",
              "communication",
              "video",
              "audio",
              "blockchain",
              "other"
            ]
          },
          "file_url": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "collected_by": {
            "type": "string"
          },
          "verified": {
            "type": "boolean",
            "default": false
          },
          "chain_of_custody": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "timestamp": {
                  "type": "string"
                },
                "action": {
                  "type": "string"
                },
                "handler": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "description": "Detailed evidence tracking log"
    },
    "transaction_hashes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Related transaction hashes"
    },
    "monitored_wallets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Wallet addresses being monitored"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "investigating",
        "documented",
        "submitted",
        "law_enforcement",
        "recovering",
        "recovered",
        "closed"
      ],
      "default": "new",
      "description": "Case status"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium",
      "description": "Case priority"
    },
    "case_priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium",
      "description": "Case priority level"
    },
    "investigation_progress": {
      "type": "number",
      "default": 0,
      "description": "Investigation progress percentage 0-100"
    },
    "assigned_investigator": {
      "type": "string",
      "description": "Email of assigned investigator"
    },
    "agencies_contacted": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Federal agencies contacted"
    },
    "submission_dates": {
      "type": "object",
      "description": "Dates when submitted to each agency"
    },
    "encrypted_notes": {
      "type": "string",
      "description": "Internal encrypted notes"
    },
    "case_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        }
      },
      "description": "Case notes log"
    },
    "recovery_amount": {
      "type": "number",
      "default": 0,
      "description": "Amount recovered"
    },
    "last_activity": {
      "type": "string",
      "format": "date-time",
      "description": "Last case activity"
    },
    "linked_case_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of manually linked related cases"
    }
  },
  "required": [
    "case_title",
    "victim_name",
    "fraud_type",
    "amount_stolen_usd"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}