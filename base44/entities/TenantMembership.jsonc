{
  "name": "TenantMembership",
  "properties": {
    "assigned_at": {
      "format": "date-time",
      "type": "string"
    },
    "assigned_by": {
      "description": "User id of the org admin who assigned the role",
      "type": "string"
    },
    "description": {
      "description": "Human-readable description of this record, up to 1000 characters.",
      "maxLength": 1000,
      "type": "string"
    },
    "invited_by": {
      "description": "Email of the inviter",
      "type": "string"
    },
    "joined_at": {
      "format": "date-time",
      "type": "string"
    },
    "last_active": {
      "description": "Last activity timestamp (if available)",
      "format": "date-time",
      "type": "string"
    },
    "organization_role": {
      "default": "VIEWER",
      "description": "Assigned organization role for this member. Takes effect once the membership is active. PLATFORM_ADMIN is never assigned here.",
      "enum": [
        "ORG_ADMIN",
        "INVESTIGATOR",
        "ANALYST",
        "CASE_MANAGER",
        "VIEWER",
        "AUDITOR"
      ],
      "type": "string"
    },
    "rejected_at": {
      "format": "date-time",
      "type": "string"
    },
    "rejected_by": {
      "type": "string"
    },
    "rejection_reason": {
      "type": "string"
    },
    "requested_at": {
      "format": "date-time",
      "type": "string"
    },
    "requested_org_name": {
      "description": "For new-org requests: the requested organization name (captured at request time)",
      "type": "string"
    },
    "requested_org_type": {
      "description": "For new-org requests: the requested organization type",
      "type": "string"
    },
    "role": {
      "default": "member",
      "description": "Legacy tenant-scoped role.",
      "enum": [
        "owner",
        "admin",
        "investigator",
        "member"
      ],
      "type": "string"
    },
    "status": {
      "default": "active",
      "description": "Membership lifecycle. pending_verification = awaiting platform-admin company verification; pending_role_assignment = company verified, awaiting org-admin role assignment; active = role assigned, full access. Writes go through the orgAccess server function only.",
      "enum": [
        "pending_verification",
        "pending_role_assignment",
        "active",
        "invited",
        "revoked"
      ],
      "type": "string"
    },
    "tenant_id": {
      "description": "Tenant id",
      "type": "string"
    },
    "user_email": {
      "description": "Member email",
      "type": "string"
    },
    "user_id": {
      "description": "Member user id",
      "type": "string"
    },
    "user_name": {
      "description": "Member display name (denormalized for roster views)",
      "type": "string"
    },
    "verification_notes": {
      "type": "string"
    },
    "verified_at": {
      "format": "date-time",
      "type": "string"
    },
    "verified_by": {
      "description": "User id of the platform admin who verified the company for this membership",
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "user_id",
    "role"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}