{
  "name": "MediaDocument",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "Email Template",
        "Press Release",
        "Talking Points",
        "Media Kit",
        "Meeting Notes",
        "Other"
      ],
      "default": "Other"
    },
    "content": {
      "type": "string"
    },
    "tags": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "content"
  ]
}