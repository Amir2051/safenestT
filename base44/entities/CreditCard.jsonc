{
  "name": "CreditCard",
  "type": "object",
  "properties": {
    "card_nickname": {
      "type": "string",
      "description": "User-friendly name for the card"
    },
    "card_type": {
      "type": "string",
      "enum": [
        "visa",
        "mastercard",
        "amex",
        "discover",
        "other"
      ],
      "description": "Type of credit card"
    },
    "encrypted_card_number": {
      "type": "string",
      "description": "Encrypted full card number"
    },
    "card_last_four": {
      "type": "string",
      "description": "Last 4 digits (visible for identification)"
    },
    "encrypted_cvv": {
      "type": "string",
      "description": "Encrypted CVV"
    },
    "expiry_month": {
      "type": "number",
      "description": "Expiration month (1-12)"
    },
    "expiry_year": {
      "type": "number",
      "description": "Expiration year (YYYY)"
    },
    "cardholder_name": {
      "type": "string",
      "description": "Name on card"
    },
    "issuing_bank": {
      "type": "string",
      "description": "Bank that issued the card"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "expired",
        "compromised",
        "blocked",
        "monitoring"
      ],
      "default": "monitoring",
      "description": "Card monitoring status"
    },
    "monitoring_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether to actively monitor this card"
    },
    "last_checked": {
      "type": "string",
      "format": "date-time",
      "description": "Last time card was checked for breaches"
    },
    "breach_status": {
      "type": "string",
      "enum": [
        "safe",
        "exposed",
        "compromised",
        "unknown"
      ],
      "default": "unknown",
      "description": "Whether card found in breaches"
    },
    "breaches_found": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "breach_name": {
            "type": "string"
          },
          "breach_date": {
            "type": "string"
          },
          "data_exposed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "severity": {
            "type": "string"
          }
        }
      },
      "description": "List of breaches where card was found"
    },
    "suspicious_activity": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "detected_at": {
            "type": "string"
          },
          "activity_type": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "risk_level": {
            "type": "string"
          }
        }
      },
      "description": "Detected suspicious activities"
    },
    "added_date": {
      "type": "string",
      "format": "date-time",
      "description": "When card was added to monitoring"
    },
    "alerts_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether to send alerts for this card"
    },
    "risk_score": {
      "type": "number",
      "default": 0,
      "description": "Risk score (0-100, higher = more risk)"
    }
  },
  "required": [
    "encrypted_card_number",
    "card_last_four",
    "cardholder_name"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}