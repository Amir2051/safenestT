{
  "name": "Script",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "content": {
      "type": "string",
      "description": "The generated script content"
    },
    "type": {
      "type": "string",
      "enum": [
        "video",
        "speech",
        "press_release",
        "social_post"
      ],
      "default": "press_release"
    },
    "project_id": {
      "type": "string",
      "description": "Linked Media Project ID"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "reviewed",
        "approved",
        "published"
      ],
      "default": "draft"
    },
    "generated_by": {
      "type": "string",
      "description": "User who requested the script"
    }
  },
  "required": [
    "title",
    "content",
    "type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}