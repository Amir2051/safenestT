{
  "name": "CaseChat",
  "type": "object",
  "properties": {
    "case_id": {
      "type": "string",
      "description": "ID of the investigation case"
    },
    "sender_email": {
      "type": "string",
      "description": "Email of the sender"
    },
    "sender_name": {
      "type": "string",
      "description": "Name of the sender"
    },
    "message": {
      "type": "string",
      "description": "Content of the message"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of file URLs"
    }
  },
  "required": [
    "case_id",
    "message",
    "sender_email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": false,
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}